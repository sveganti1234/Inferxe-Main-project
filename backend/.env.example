# NVIDIA Nemotron Provider Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Local PostgreSQL Database Configuration (Managed via pgAdmin 4)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/inferxe_inference_db

# AWS Cognito Configuration
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# Optional Inference Server Port (Default: 8001)
INFERENCE_PORT=8001

