# NVIDIA Nemotron Provider Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Shared Supabase PostgreSQL Connection String (Notifications, Wallets, GPU Deployments)
# Used by backend/notifications (port 8002) across the team so everyone connects to the shared project DB.
SUPABASE_DATABASE_URL=

# Optional Legacy Local PostgreSQL URL (Managed via pgAdmin 4; not required for Supabase runtime)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/inferxe_inference_db

# AWS Cognito Configuration
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# AWS_COGNITO_* aliases (backward compatibility for customerAuth.js)
# These mirror the COGNITO_* values above. Only one naming convention is needed.
AWS_COGNITO_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=your-cognito-client-id

# Server-Only Supabase REST Credentials (FastAPI & Node auth/profile sync)
# Preserve the exact variable name SUPABASE_SERVICE_ROLE_KEY (set to your project's
# Secret / Service Role key — NEVER a Personal Access Token or Publishable key).
# Never place these credentials in frontend/.env* or prefix them with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional Inference & Notifications Server Ports
INFERENCE_PORT=8001
NOTIFICATIONS_PORT=8002



# Demo "Add money" (no payment gateway): customers credit their own wallet. Keep off in production.
WALLET_SELF_RECHARGE_ENABLED=false

# GPU providers offered for new deployments (/api/v1/gpu/*), comma-separated: mock, jarvislabs.
# "mock" simulates instances in memory; keep it off in production once a real provider is configured.
GPU_PROVIDERS=mock

# GPU notebooks (JupyterLab through the Inferxe notebook proxy at /nb/<notebook id>/).
# NOTEBOOK_PROXY_SECRET: random string, at least 32 characters (e.g. `openssl rand -hex 32`). Required to launch
#   or open GPU notebooks; it derives each notebook's internal JupyterLab token and signs proxy sessions.
#   Changing it locks out every running notebook (their JupyterLab tokens change).
# NOTEBOOK_PROXY_BASE_URL: public origin that serves /nb/... through this backend. https:// required (http:// only
#   for localhost). Today: the backend's own URL (temporary; notebooks then share its origin). Later: a dedicated
#   notebook domain routed to this backend. Leave empty and notebooks run but no customer link is issued.
# Not production-ready until verified: see backend/inference/notebook_proxy.py for the open infrastructure items.
NOTEBOOK_PROXY_SECRET=
NOTEBOOK_PROXY_BASE_URL=
