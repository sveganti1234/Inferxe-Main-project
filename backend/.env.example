# NVIDIA Nemotron Provider Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Shared Supabase PostgreSQL Connection String (Notifications, Wallets, GPU Deployments)
# Used by backend/notifications (port 8000) across the team so everyone connects to the shared project DB.
SUPABASE_DATABASE_URL=

# Optional Legacy Local PostgreSQL URL (Managed via pgAdmin 4; not required for Supabase runtime)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# AWS Cognito Configuration
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# Server-Only Supabase REST Credentials (FastAPI & Node auth/profile sync)
# Preserve the exact variable name SUPABASE_SERVICE_ROLE_KEY (set to your project's
# Secret / Service Role key — NEVER a Personal Access Token or Publishable key).
# Never place these credentials in frontend/.env* or prefix them with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional Inference & Notifications Server Ports
INFERENCE_PORT=8001
NOTIFICATIONS_PORT=8000


