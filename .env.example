# ==============================================================================
# Inferxe Platform Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication & Backend Gateway
# ------------------------------------------------------------------------------
VITE_ADMIN_AUTH_ENDPOINT=/api/admin
ADMIN_EMAIL=admin@inferxe.com
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=inferxe_prod_enterprise_admin_sec_key_2026_x9
ADMIN_AUTH_PORT=5174

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (Notifications & Multi-User Data)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inferxe_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Alternative aliases recognized by backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inferxe_local
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 3. Social Single Sign-On (SSO - Google & GitHub OAuth)
# ------------------------------------------------------------------------------
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Form & Contact Endpoints
# ------------------------------------------------------------------------------
VITE_FORM_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. RAG, Vector Knowledge Base & Datasets (Python Backend)
# ------------------------------------------------------------------------------
INFERXE_RAG_ADMIN_KEY=
CHROMA_PERSIST_DIR=database/chroma_db
DATASET_DIR=database/datasets

# ------------------------------------------------------------------------------
# 6. Model Inference Marketplace API
# ------------------------------------------------------------------------------
INFERXE_BASE_URL=https://api.inferxe.com
INFERXE_API_KEY=
