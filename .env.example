# ==============================================================================
# Inferxe Platform Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication & Backend Gateway
# ------------------------------------------------------------------------------
VITE_ADMIN_AUTH_ENDPOINT=/api/admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_AUTH_PORT=5174

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database (Notifications & Multi-User Data)
# ------------------------------------------------------------------------------
# Set this to the PostgreSQL connection string from the existing Supabase project.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Social Single Sign-On (SSO - Google & GitHub OAuth)
# ------------------------------------------------------------------------------
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Form & Contact Endpoints
# ------------------------------------------------------------------------------
VITE_FORM_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. RAG, Vector Knowledge Base & Datasets (Python Backend)
# ------------------------------------------------------------------------------
INFERXE_RAG_ADMIN_KEY=
CHROMA_PERSIST_DIR=database/chroma_db
DATASET_DIR=database/datasets

# ------------------------------------------------------------------------------
# 6. Model Inference Marketplace API
# ------------------------------------------------------------------------------
INFERXE_BASE_URL=https://api.inferxe.com
INFERXE_API_KEY=

# ------------------------------------------------------------------------------
# 7. AWS Cognito Authentication (Frontend)
# ------------------------------------------------------------------------------
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-cognito-client-id

# Server-side Supabase REST credentials (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY)
# live exclusively in backend/.env (see backend/.env.example).
# Never store SUPABASE_SERVICE_ROLE_KEY in root .env, frontend/.env*, or any VITE_* variable.
