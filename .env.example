# ───────────────────────────────────────────────────────────
# Inferxe — Environment Configuration
# ───────────────────────────────────────────────────────────

# Authentication API Endpoint
# Connect your authentication service backend:
VITE_AUTH_API_ENDPOINT=https://api.inferxe.com/v1/auth

# Marketplace Backend API Base URL
VITE_API_BASE_URL=https://api.inferxe.com/v1

# Contact Form Submission Endpoint (Optional: Formspree, Netlify Forms, or custom webhook)
VITE_FORM_ENDPOINT=

# AWS Cognito (optional). When both are set, Sign in / Sign up use Cognito
# (USER_PASSWORD_AUTH) and the returned ID token (JWT) becomes the session token.
# Enable ALLOW_USER_PASSWORD_AUTH on a public app client (no client secret).
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# Backend Admin Credentials (Development / Initial Demo Configuration)
# Keep strictly server-side; do NOT prefix with VITE_ to prevent client bundle exposure.
ADMIN_EMAIL=admin@inferxe.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# RAG reindex endpoint key and optional dataset location
INFERXE_RAG_ADMIN_KEY=
INFERXE_DATASET_DIR=
