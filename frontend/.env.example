# ==============================================================================
# Inferxe Frontend Environment Template (frontend/.env.example)
# Copy this file to frontend/.env and adjust values for your environment.
# Vite loads VITE_* variables from this directory (where vite.config.ts lives).
#
# SECURITY GUARANTEE:
# Server-side Supabase REST credentials (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY)
# live exclusively in backend/.env (see backend/.env.example).
# NEVER put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or any VITE_SUPABASE_* variable here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Cognito Authentication (Frontend Login)
# ------------------------------------------------------------------------------
# AWS region where your Cognito User Pool is hosted.
VITE_COGNITO_REGION=ap-south-1

# Cognito User Pool ID (from AWS Console > Cognito > User Pools).
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx

# Cognito User Pool Client ID (from App client settings).
VITE_COGNITO_CLIENT_ID=your-cognito-client-id

# Cognito hosted UI domain (without https:// prefix).
# Used for OAuth sign-in flows. Optional — if omitted, OAuth flows are disabled.
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.ap-south-1.amazoncognito.com

# Callback URL after successful sign-in.
VITE_COGNITO_REDIRECT_SIGN_IN=http://127.0.0.1:5173/login/callback

# Redirect URL after sign-out.
VITE_COGNITO_REDIRECT_SIGN_OUT=http://127.0.0.1:5173

# Cognito token issuer authority (derived from region + user pool ID).
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_xxxxxxxxx

# Cognito OAuth scopes requested during sign-in.
VITE_COGNITO_SCOPE=phone openid email

# ------------------------------------------------------------------------------
# 2. Backend Endpoints (Optional in local dev — requests route via Vite proxy)
# ------------------------------------------------------------------------------
# In local development, leave these blank to route through Vite proxy to local ports:
#   - /api/v1/* -> http://127.0.0.1:8001 (Inference, API keys, SSH keys, Notebooks)
#   - /api/notifications, /api/wallet, /api/chat -> http://127.0.0.1:8000 (Notifications, Wallet, RAG)
# In production, set these to your deployed origins (no trailing slash).
# VITE_INFERENCE_API_ENDPOINT=
# VITE_NOTIFICATIONS_API_ENDPOINT=http://127.0.0.1:8000
# VITE_RAG_API_ENDPOINT=
# VITE_ADMIN_AUTH_ENDPOINT=/api/admin
