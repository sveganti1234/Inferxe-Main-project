# ==============================================================================
# Inferxe Frontend Public Environment Template (frontend/.env.example)
# Copy to frontend/.env and populate with your shared AWS Cognito App Client values.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or VITE_SUPABASE_* variables here.
# ==============================================================================

VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-cognito-client-id

# Optional overrides (left blank in local dev so requests route through Vite proxy)
# VITE_INFERENCE_API_ENDPOINT=
# VITE_RAG_API_ENDPOINT=
# VITE_ADMIN_AUTH_ENDPOINT=/api/admin
